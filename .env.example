# --- LLM configuration (MTJ DevAgent core orchestrator) ---
# Never commit a real .env file. This file only documents required variables.

# OpenAI-compatible base URL for the Claude relay
LLM_BASE_URL=https://api.llmsrelay.com/v1

# Model identifier
LLM_MODEL=claude-sonnet-4.6

# Secret API key - set this in your real .env (gitignored) or in your
# deployment platform's secret manager. NEVER put the real value here.
LLM_API_KEY=

# Optional: max tokens per completion
LLM_MAX_TOKENS=4096

# Optional: request timeout in ms
LLM_TIMEOUT_MS=120000

# --- Agent / sandbox configuration ---

# Root directory the agent is allowed to read/write/execute within.
# Defaults to ./workspace if not set. This is a hard safety boundary.
AGENT_WORKSPACE_ROOT=./workspace

# Max number of PLAN->CODE->TEST->FIX loop iterations before stopping
AGENT_MAX_LOOP_ITERATIONS=8

# Log level: debug | info | warn | error
LOG_LEVEL=info
